{
  "name": "claude-hud",
  "version": "0.15.2",
  "description": "Real-time statusline HUD for Claude Code",
  "type": "module",
  "main": "hud.mjs",
  "files": [
    "hud.mjs",
    "collector.mjs",
    "fence.mjs",
    "install.mjs",
    "dist/index.js",
    "src/",
    "skills/",
    "scripts/statusline.mjs",
    ".claude-plugin/"
  ],
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --import ./tests/clean-env.js --test",
    "test:update-snapshots": "UPDATE_SNAPSHOTS=1 npm test",
    "test:stdin": "echo '{\"model\":{\"display_name\":\"Opus\"},\"context_window\":{\"current_usage\":{\"input_tokens\":45000},\"context_window_size\":200000},\"transcript_path\":\"/tmp/test.jsonl\"}' | node hud.mjs"
  },
  "keywords": [
    "claude-code",
    "statusline",
    "hud"
  ],
  "author": "Jarrod Watts",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
